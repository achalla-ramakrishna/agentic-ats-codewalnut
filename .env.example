# Copy to .env (gitignored) or export in your shell. Never commit real values.

# Database (defaults shown; local MySQL 8 with database `ats`, user ats/ats).
# On Railway, MYSQL_URL=${{MySQL.MYSQL_URL}} alone is enough; DB_URL wins if both are set.
DB_URL=jdbc:mysql://localhost:3306/ats?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=ats
DB_PASSWORD=ats
# Tests use a separate database (created automatically if the user may)
TEST_DB_URL=jdbc:mysql://localhost:3306/ats_test?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&createDatabaseIfNotExist=true

# Google sign-in (optional locally; the dev login works without it).
# Authorised redirect URI: http://localhost:5173/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The same client also lets staff connect Google Calendar and Gmail (send only) to
# schedule interviews and email candidates (redirect URI:
# http://localhost:5173/oauth2/callback/google-calendar). The dev profile uses a
# fake calendar and mailer instead. Set to false to switch both off.
ATS_GOOGLE_CALENDAR_ENABLED=true

# AI assistant and résumé reading on openings (optional; without it Ask AI and
# Upload résumés are hidden). ATS_AI_WORKERS: résumés read at a time (default 3).
ANTHROPIC_API_KEY=
ATS_AI_WORKERS=3

# WhatsApp Business API (optional; without it, WhatsApp opens with the message ready).
# See docs/deploy-railway.md. Never commit real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Staff domains: these emails must be provisioned staff. Any other verified Google
# account (e.g. personal Gmail) signs in as a candidate.
ATS_ALLOWED_DOMAINS=codewalnut.com
ATS_BOOTSTRAP_ADMINS=

# Production: never enable the dev profile (it adds a password-less login).
