# Copy to .env, chmod 600; obtain image digests from successful tested CI runs.
ATS_BACKEND_IMAGE=ghcr.io/your-company/ats-backend@sha256:REPLACE
ATS_BLOB_BRIDGE_IMAGE=ghcr.io/your-company/ats-blob-bridge@sha256:REPLACE
MYSQL_IMAGE=mysql:8.0@sha256:REPLACE
CADDY_IMAGE=caddy:2@sha256:REPLACE
DB_PASSWORD=replace-with-unique-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-unique-random-password
ATS_ORIGIN_HOST=ats-origin.example.invalid
ATS_PUBLIC_HOST=ats.example.invalid
ATS_BLOB_BRIDGE_SECRET=replace-with-32-plus-random-characters
BLOB_READ_WRITE_TOKEN=replace-with-private-store-token
ATS_BLOB_STORE_HOST=replace.private.blob.vercel-storage.com
# Fail closed for first boot / copied production data. Change only at the runbook gate.
ATS_REHEARSAL_ENABLED=true
ATS_MAINTENANCE_ENABLED=true
ATS_BACKGROUND_WORK_ENABLED=false
ATS_DOCUMENT_STORAGE_ENABLED=false
